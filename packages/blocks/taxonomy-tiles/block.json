{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "factory/taxonomy-tiles",
  "title": "Tuiles de catégories",
  "category": "design",
  "icon": "category",
  "description": "Grandes tuiles cliquables vers des catégories ou des rayons. Les titres, descriptions et images viennent de la taxonomie — rien n'est écrit dans le bloc.",
  "textdomain": "factory-core",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "padding": true, "margin": true }
  },
  "attributes": {
    "titre":            { "type": "string",  "default": "" },
    "taxonomie":        { "type": "string",  "default": "category" },
    "termes":           { "type": "array",   "default": [], "items": { "type": "number" } },
    "source":           { "type": "string",  "default": "manuelle", "enum": ["manuelle", "auto"] },
    "limite":           { "type": "number",  "default": 6 },
    "colonnes":         { "type": "number",  "default": 2 },
    "ratio":            { "type": "string",  "default": "3:2", "enum": ["1:1", "3:2", "4:3", "16:9"] },
    "libelleCta":       { "type": "string",  "default": "" },
    "afficheSousTitre": { "type": "boolean", "default": true },
    "niveauTitre":      { "type": "number",  "default": 2 }
  },
  "style": "file:./style.css",
  "render": "file:./render.php"
}
