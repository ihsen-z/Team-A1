{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "factory/services-grid",
  "title": "Grille de services",
  "category": "design",
  "icon": "grid-view",
  "description": "Grille de prestations ou d'arguments : titre, texte, icône, lien.",
  "textdomain": "factory-core",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide"],
    "spacing": { "padding": true, "margin": true },
    "color": { "background": true, "text": true }
  },
  "attributes": {
    "titre":    { "type": "string", "default": "" },
    "colonnes": { "type": "number", "default": 3 },
    "items": {
      "type": "array",
      "default": [],
      "items": { "type": "object" }
    }
  },
  "style": "file:./style.css",
  "render": "file:./render.php"
}
