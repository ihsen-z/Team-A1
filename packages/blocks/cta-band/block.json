{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "factory/cta-band",
  "title": "Bandeau d'appel à l'action",
  "category": "design",
  "icon": "megaphone",
  "description": "Bandeau de conversion : titre, message court et un seul bouton, avec photo de fond optionnelle et dégradé latéral ou vertical.",
  "textdomain": "factory-core",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "padding": true, "margin": true },
    "color": { "background": true, "text": true }
  },
  "attributes": {
    "titre":    { "type": "string", "default": "" },
    "message":  { "type": "string", "default": "" },
    "ctaTexte": { "type": "string", "default": "" },
    "ctaUrl":   { "type": "string", "default": "" },
    "imageId":  { "type": "number", "default": 0 },
    "variante": { "type": "string", "default": "primaire", "enum": ["primaire", "accent", "sobre", "photo"] },
    "degrade":  { "type": "string", "default": "lateral", "enum": ["lateral", "vertical", "aucun"] },
    "niveauTitre":        { "type": "number", "default": 2 },
    "couleurTitre":       { "type": "string", "default": "" },
    "couleurTexte":       { "type": "string", "default": "" },
    "couleurBouton":      { "type": "string", "default": "" },
    "couleurBoutonTexte": { "type": "string", "default": "" }
  },
  "style": "file:./style.css",
  "render": "file:./render.php"
}
