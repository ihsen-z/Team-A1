{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "factory/cta-band",
  "title": "Bandeau d'appel à l'action",
  "category": "design",
  "icon": "megaphone",
  "description": "Bandeau de conversion en fin de page : message court et un seul bouton.",
  "textdomain": "factory-core",
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "spacing": { "padding": true, "margin": true },
    "color": { "background": true, "text": true }
  },
  "attributes": {
    "message":  { "type": "string", "default": "" },
    "ctaTexte": { "type": "string", "default": "" },
    "ctaUrl":   { "type": "string", "default": "" },
    "variante": { "type": "string", "default": "primaire", "enum": ["primaire", "accent", "sobre"] }
  },
  "style": "file:./style.css",
  "render": "file:./render.php"
}
