{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/php-lint.sh",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(php -l:*)",
      "Bash(composer lint:*)",
      "Bash(composer analyse:*)",
      "Bash(bash -n:*)",
      "Bash(wp --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./clients/**/.env)",
      "Read(./**/wp-config.php)"
    ]
  }
}
