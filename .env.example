# Copie en .env (jamais versionné) et adapte.

# --- Racine des installations locales ---------------------------------------
SITES_ROOT=$HOME/sites

# --- Base de données (environnement local) ----------------------------------
WP_DB_NAME=factory_local
WP_DB_USER=root
WP_DB_PASS=
WP_DB_HOST=127.0.0.1
WP_DB_PREFIX=wp_

# --- Compte administrateur créé au scaffold ---------------------------------
# N'utilise jamais « admin » : l'énumération de ce nom est la première chose
# que teste un bot. Le mot de passe doit être unique par site.
WP_ADMIN_USER=atelier
WP_ADMIN_EMAIL=toi@exemple.fr
WP_ADMIN_PASS=

# --- Divers -----------------------------------------------------------------
WP_DEBUG=true
